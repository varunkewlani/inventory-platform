# Copy this file to .env and fill in real values. Never commit .env.

# --- MySQL ---
DB_ROOT_PASSWORD=rootpass
DB_NAME=inventory_platform
DB_USERNAME=inventory
DB_PASSWORD=inventory
DB_HOST=localhost
DB_PORT=3306
# TLS for managed MySQL providers (e.g. Aiven) that require it; leave false for local/docker-compose
DB_USE_SSL=false
DB_REQUIRE_SSL=false
DB_VERIFY_SERVER_CERT=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# TLS for managed Redis providers (e.g. Upstash) that require it
REDIS_SSL_ENABLED=false

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-value-in-real-envs
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth cookie --- (set to true once served over HTTPS)
COOKIE_SECURE=false
# Lax for same-site (localhost, or frontend+backend on one domain); None (requires
# COOKIE_SECURE=true) when frontend and backend are deployed on different sites
COOKIE_SAME_SITE=Lax

# --- Server ---
SERVER_PORT=8080

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
