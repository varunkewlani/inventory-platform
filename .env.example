# Copy this file to .env and fill in real values. Never commit .env.

# --- MySQL ---
DB_ROOT_PASSWORD=rootpass
DB_NAME=uphead_inventory
DB_USERNAME=uphead
DB_PASSWORD=uphead
DB_HOST=localhost
DB_PORT=3306

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-value-in-real-envs
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth cookie --- (set to true once served over HTTPS)
COOKIE_SECURE=false

# --- Server ---
SERVER_PORT=8080

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
